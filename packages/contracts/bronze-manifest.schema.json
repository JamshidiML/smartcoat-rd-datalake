{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smartcoat.local/contracts/bronze-manifest.schema.json",
  "title": "SmartCoat Bronze Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version", "ingestion_id", "bronze_status", "department",
    "uploader_user_id", "uploader_display_name", "uploaded_at_utc",
    "original_filename", "stored_object_key", "detected_mime_type",
    "declared_file_type", "byte_size", "sha256", "duplicate_of_ingestion_id",
    "source_channel", "metadata_schema_version"
  ],
  "properties": {
    "manifest_version": {"const": "1.0"},
    "ingestion_id": {"type": "string", "format": "uuid"},
    "bronze_status": {"const": "COMMITTED"},
    "department": {"const": "RND"},
    "uploader_user_id": {"type": "string", "pattern": "^usr_[A-Za-z0-9_-]+$"},
    "uploader_display_name": {"type": "string", "minLength": 1},
    "uploaded_at_utc": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "original_filename": {"type": "string", "minLength": 1},
    "stored_object_key": {"type": "string", "pattern": "^rd/[0-9]{4}/[0-9]{2}/[0-9a-f-]{36}/original/[^/]+$"},
    "detected_mime_type": {
      "enum": ["image/jpeg", "image/png", "image/heic", "application/pdf", "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", "application/vnd.ms-excel"]
    },
    "declared_file_type": {"enum": ["PHOTO", "PDF", "EXCEL"]},
    "byte_size": {"type": "integer", "minimum": 1, "maximum": 52428800},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "duplicate_of_ingestion_id": {"type": ["string", "null"], "format": "uuid"},
    "source_channel": {"const": "WEB_UPLOAD"},
    "metadata_schema_version": {"const": "1.0"}
  }
}
