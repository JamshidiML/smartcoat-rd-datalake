# Copy to .env. Never commit the populated file.
POSTGRES_DB=smartcoat_rd
POSTGRES_USER=smartcoat_admin
POSTGRES_PASSWORD=change-me-postgres-admin-password
POSTGRES_APP_USER=smartcoat_app
POSTGRES_APP_PASSWORD=change-me-postgres-app-password
# Bootstrap compatibility only. Migration 0002 disables this legacy shared login.
POSTGRES_INGESTION_PASSWORD=change-me-postgres-ingestion-password
POSTGRES_OCR_PASSWORD=change-me-postgres-ocr-password
POSTGRES_REVIEW_PASSWORD=change-me-postgres-review-password
POSTGRES_BACKUP_PASSWORD=change-me-postgres-backup-password
DATABASE_INGESTION_URL=postgresql://smartcoat_ingestion:change-me-postgres-ingestion-password@postgres:5432/smartcoat_rd
DATABASE_OCR_URL=postgresql://smartcoat_ocr:change-me-postgres-ocr-password@postgres:5432/smartcoat_rd
DATABASE_REVIEW_URL=postgresql://smartcoat_review:change-me-postgres-review-password@postgres:5432/smartcoat_rd
DATABASE_BACKUP_URL=postgresql://smartcoat_backup:change-me-postgres-backup-password@postgres:5432/smartcoat_rd
MIGRATION_DATABASE_URL=postgresql://smartcoat_admin:change-me-postgres-admin-password@postgres:5432/smartcoat_rd
POSTGRES_ROLE_ADMIN_URL=postgresql://smartcoat_admin:change-me-postgres-admin-password@postgres:5432/smartcoat_rd
HOST_POSTGRES_PORT=5432

MINIO_ROOT_USER=change-me-minio-root-user
MINIO_ROOT_PASSWORD=change-me-minio-root-password
MINIO_ENDPOINT=minio:9000
MINIO_SECURE=false
HOST_MINIO_PORT=9000
HOST_MINIO_CONSOLE_PORT=9001
MINIO_APP_ACCESS_KEY=app-ingestion
MINIO_APP_SECRET_KEY=change-me-app-ingestion-secret
MINIO_OCR_ACCESS_KEY=ocr-worker
MINIO_OCR_SECRET_KEY=change-me-ocr-worker-secret
MINIO_BACKUP_ACCESS_KEY=backup
MINIO_BACKUP_SECRET_KEY=change-me-backup-secret
MINIO_HOLD_APPLIER_ACCESS_KEY=legal-hold-applier
MINIO_HOLD_APPLIER_SECRET_KEY=change-me-legal-hold-applier-secret
LEGAL_HOLD_APPLIER_CALL_TOKEN=change-me-legal-hold-applier-call-token-at-least-32-characters

LOCAL_USER_ID=usr_founder
LOCAL_USER_DISPLAY_NAME="SmartCoat Founder"
LOCAL_USER_EMAIL=founder@localhost
LOCAL_USER_PASSWORD=change-me-local-password
SESSION_SECRET=change-me-at-least-32-random-characters
ALLOW_PHASE_1_SOLO_SELF_REVIEW=true

API_ORIGIN=http://127.0.0.1:8000
WEB_ORIGIN=http://127.0.0.1:8080
HOST_API_PORT=8000
HOST_WEB_PORT=8080
MAX_UPLOAD_BYTES=52428800
OCR_POLL_SECONDS=3
OCR_LANGUAGES=en,de
# fast: deterministic preprocessing + Paddle detection/recognition; accurate: adds orientation and unwarping models
OCR_PIPELINE_PROFILE=fast
# Deterministic long-edge cap for photos and rendered PDF pages (allowed range: 1200-4000)
OCR_MAX_IMAGE_SIDE=2400
BACKUP_ROOT=~/SmartCoatRDLakeBackups
MINIO_DATA_DIR=./.local-data/minio
POSTGRES_DATA_DIR=./.local-data/postgres
