{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": [
        "arn:aws:s3:::sc-rd-bronze-originals",
        "arn:aws:s3:::sc-rd-bronze-manifests"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetObjectVersion",
        "s3:GetObjectRetention",
        "s3:PutObjectRetention"
      ],
      "Resource": [
        "arn:aws:s3:::sc-rd-bronze-originals/rd/*",
        "arn:aws:s3:::sc-rd-bronze-manifests/rd/*"
      ]
    },
    {
      "Effect": "Deny",
      "Action": [
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:GetObjectLegalHold",
        "s3:PutObjectLegalHold",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::sc-rd-bronze-originals/rd/*",
        "arn:aws:s3:::sc-rd-bronze-manifests/rd/*"
      ]
    }
  ]
}
