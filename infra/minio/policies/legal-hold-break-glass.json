{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["s3:GetBucketLocation", "s3:GetBucketVersioning", "s3:ListBucket"],
      "Resource": [
        "arn:aws:s3:::sc-rd-bronze-originals",
        "arn:aws:s3:::sc-rd-bronze-manifests",
        "arn:aws:s3:::sc-rd-legal-hold-audit"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetObjectLegalHold",
        "s3:PutObjectLegalHold",
        "s3:GetObjectRetention",
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": [
        "arn:aws:s3:::sc-rd-bronze-originals/rd/*",
        "arn:aws:s3:::sc-rd-bronze-manifests/rd/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:GetObjectVersion", "s3:PutObject"],
      "Resource": ["arn:aws:s3:::sc-rd-legal-hold-audit/break-glass/*"]
    },
    {
      "Effect": "Deny",
      "Action": [
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:PutObjectRetention",
        "s3:BypassGovernanceRetention"
      ],
      "Resource": [
        "arn:aws:s3:::sc-rd-bronze-originals/rd/*",
        "arn:aws:s3:::sc-rd-bronze-manifests/rd/*",
        "arn:aws:s3:::sc-rd-legal-hold-audit/break-glass/*"
      ]
    }
  ]
}
