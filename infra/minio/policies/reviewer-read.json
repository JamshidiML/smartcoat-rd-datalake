{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation", "s3:GetBucketVersioning"],
      "Resource": [
        "arn:aws:s3:::sc-rd-bronze-originals",
        "arn:aws:s3:::sc-rd-bronze-manifests",
        "arn:aws:s3:::sc-rd-ocr-artifacts"
      ]
    },
    {
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:GetObjectVersion", "s3:GetObjectRetention"],
      "Resource": [
        "arn:aws:s3:::sc-rd-bronze-originals/rd/*",
        "arn:aws:s3:::sc-rd-bronze-manifests/rd/*",
        "arn:aws:s3:::sc-rd-ocr-artifacts/rd/*"
      ]
    }
  ]
}
